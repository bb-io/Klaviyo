<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Product>Klaviyo [Beta]</Product>
        <Description>Klaviyo connector for managing translatable content.</Description>
        <Version>1.0.1</Version>
        <AssemblyName>Apps.Klaviyo</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Blackbird.Applications.SDK.Blueprints" Version="1.0.2" />
        <PackageReference Include="Blackbird.Applications.SDK.Extensions.FileManagement" Version="1.1.0" />
        <PackageReference Include="Blackbird.Applications.Sdk.Utils" Version="1.1.0-rc.8709" />
        <PackageReference Include="Blackbird.Filters" Version="1.2.12" />
        <PackageReference Include="HtmlAgilityPack" Version="1.12.3" />
    </ItemGroup>

</Project>
